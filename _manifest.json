{
  "manifest_version": 2,
  "id": "LowValueTarget.deepseek-anthropic-provider",
  "version": "0.3.0",
  "name": "Deepseek联网工具",
  "description": "通过 DeepSeek 官方 Search 与 Fetch API 搜索网页、抓取 Markdown 正文，复用 MaiBot 模型供应商中的 DeepSeek 密钥。",
  "author": {
    "name": "LowValueTarget",
    "url": "https://github.com/LowValueTarget777"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/LowValueTarget777/deepseek-anthropic-provider",
    "homepage": "https://github.com/LowValueTarget777/deepseek-anthropic-provider",
    "documentation": "https://github.com/LowValueTarget777/deepseek-anthropic-provider/blob/main/USAGE.md",
    "issues": "https://github.com/LowValueTarget777/deepseek-anthropic-provider/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.2",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.1,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "maibot-plugin-sdk",
      "version_spec": ">=2.5.2,<3.0.0"
    }
  ],
  "capabilities": [
    "tool",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
