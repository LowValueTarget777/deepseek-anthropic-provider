{
  "manifest_version": 2,
  "id": "LowValueTarget.deepseek-anthropic-provider",
  "version": "0.1.0",
  "name": "DeepSeek Anthropic Provider",
  "description": "通过 Anthropic SDK 调用 DeepSeek V4，支持思考模式和 DeepSeek Anthropic 联网搜索工具。",
  "author": {
    "name": "LowValueTarget",
    "url": "https://github.com/LowValueTarget777"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/LowValueTarget777/deepseek-anthropic-provider",
    "homepage": "https://github.com/LowValueTarget777/deepseek-anthropic-provider",
    "documentation": "https://github.com/LowValueTarget777/deepseek-anthropic-provider/blob/main/USAGE.md",
    "issues": "https://github.com/LowValueTarget777/deepseek-anthropic-provider/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "anthropic",
      "version_spec": ">=0.104.0,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "maibot-plugin-sdk",
      "version_spec": ">=2.0.0"
    }
  ],
  "capabilities": [
    "send.text"
  ],
  "llm_providers": [
    {
      "client_type": "deepseek.anthropic",
      "name": "DeepSeek Anthropic Provider",
      "description": "通过 Anthropic SDK 调用 DeepSeek V4，并支持 DeepSeek Anthropic 联网搜索工具。",
      "version": "0.1.0"
    }
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
